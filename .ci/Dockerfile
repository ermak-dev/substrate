FROM docker.io/otel/weaver:v0.25.1@sha256:9ad46ca9cd4fa5974b121f886aa3e9946a8ef8ea905001a96c018d21f9db87ca AS weaver
FROM docker.io/library/golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang-format python3 python3-venv shellcheck unzip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=weaver /weaver/weaver /usr/local/bin/weaver
